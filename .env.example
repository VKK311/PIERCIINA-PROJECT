# Публичен адрес на системата (без / накрая)
SITE_URL=https://card.pierciina.com

# Supabase (база данни + частен bucket с сертификатите)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Частен Storage bucket, в който стоят wwdr.pem, signerCert.pem, signerKey.pem и google-service-account.json
SECRETS_BUCKET=wallet-secrets

# Админ
ADMIN_EMAIL=pierciina1@gmail.com
ADMIN_PASSWORD=
# Дълъг случаен низ, напр. `openssl rand -hex 32`
SESSION_SECRET=

# Apple Wallet
APPLE_PASS_TYPE_ID=pass.com.pierciina.loyalty
APPLE_TEAM_ID=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet (по избор — без тези стойности бутонът за Android се скрива)
GOOGLE_ISSUER_ID=

# Brevo имейли до админа (по избор)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=pierciina1@gmail.com

# Визия на картата (временни стойности, докато не получим логото и цветовете)
CARD_BG_COLOR=#111111
CARD_FG_COLOR=#FFFFFF
CARD_LABEL_COLOR=#F7C948
CARD_STAR_COLOR=#F7C948

# Координати на студиото (ул. „Граф Игнатиев“ 74) — проверете в Google Maps
STUDIO_LAT=42.6885
STUDIO_LNG=23.3265
