{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VKK311/PIERCIINA-PROJECT/docs/pink-mall/system-contracts/02_PRODUCT_CREATIVE_OBJECT.schema.json",
  "title": "PINK MALL Product Reference Package",
  "description": "Shape of the handoff a future Product Creative system assembles BEFORE generation. No such system exists. The package is a GENERATION INPUT, never a Product Truth record, and it carries only what can truthfully exist before an output does: no generated-output status and no clothing-fit RESULT, only evidence readiness. Instances are snapshots and MUST NOT be committed to this public repository.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageRef": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference, unique within this package only. Persistent ids belong to a future operational system and are NOT defined here."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "isProductTruthRecord": {
      "const": false
    },
    "productIdentity": {
      "type": "object",
      "required": [
        "pmId",
        "manufacturerItemNumber",
        "variant",
        "truthSource",
        "mayBeWrittenByCreativeSystem"
      ],
      "properties": {
        "pmId": {
          "type": "string",
          "pattern": "^PM-\\d{3}$"
        },
        "manufacturerItemNumber": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "truthSource": {
          "type": "string",
          "enum": [
            "PRODUCT_ONBOARDING_SYSTEM",
            "CANONICAL_REPOSITORY"
          ]
        },
        "mayBeWrittenByCreativeSystem": {
          "const": false
        },
        "similarSkuSubstituted": {
          "const": false
        }
      },
      "additionalProperties": false,
      "description": "Read from Product Truth. The exact SKU and exact variant are both required: a package that cannot name them cannot lock them."
    },
    "productRole": {
      "type": "string",
      "enum": [
        "DETAIL",
        "SUPPORTING",
        "HERO"
      ],
      "description": "Set by contract 01. Role NONE means no real product is present, so no package is assembled at all — that is why NONE is absent from this enum rather than forbidden by contract 02."
    },
    "productGeometrySources": {
      "type": "array",
      "minItems": 1,
      "description": "At least one exact-product geometry source is required. A package for a product-led task cannot be assembled without one.",
      "items": {
        "type": "object",
        "required": [
          "sourceRef",
          "derivesFromExactProduct",
          "isAvatarFrame",
          "isGenericCategoryImagery",
          "isDifferentColourway"
        ],
        "properties": {
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "derivesFromExactProduct": {
            "const": true
          },
          "isAvatarFrame": {
            "const": false
          },
          "isGenericCategoryImagery": {
            "const": false
          },
          "isDifferentColourway": {
            "const": false
          },
          "coversLockCategories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "IDENTITY",
                "VARIANT",
                "SILHOUETTE",
                "GEOMETRY",
                "CONSTRUCTION",
                "PROPORTIONS",
                "COLOUR",
                "BRANDING_MARKINGS",
                "DISTINCTIVE_DETAILS"
              ]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "productWearReference": {
      "type": "object",
      "required": [
        "referenceRef",
        "authoritativeForGeometry"
      ],
      "properties": {
        "referenceRef": {
          "type": "string",
          "minLength": 1
        },
        "authoritativeForGeometry": {
          "const": false
        },
        "informsPlacementOnly": {
          "const": true
        }
      },
      "additionalProperties": false,
      "description": "Optional. Never geometry authority."
    },
    "productLocks": {
      "type": "array",
      "minItems": 9,
      "description": "Every core lock must be present and engaged. Omitting one is how a product gets quietly redesigned.",
      "items": {
        "type": "object",
        "required": [
          "lockId",
          "engaged"
        ],
        "properties": {
          "lockId": {
            "type": "string",
            "enum": [
              "IDENTITY",
              "VARIANT",
              "SILHOUETTE",
              "GEOMETRY",
              "CONSTRUCTION",
              "PROPORTIONS",
              "COLOUR",
              "BRANDING_MARKINGS",
              "DISTINCTIVE_DETAILS"
            ]
          },
          "engaged": {
            "const": true
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "IDENTITY"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "VARIANT"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "SILHOUETTE"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "GEOMETRY"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "CONSTRUCTION"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "PROPORTIONS"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "COLOUR"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId"
            ],
            "properties": {
              "lockId": {
                "const": "BRANDING_MARKINGS"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
