          "minLength": 1
        },
        "isAuthoritative": {
          "const": false
        },
        "mayProduce": {
          "type": "array",
          "const": [
            "GENERATED_OUTPUT"
          ]
        }
      },
      "additionalProperties": false
    },
    "clothingFitEvidence": {
      "type": "object",
      "required": [
        "garmentGeometryEvidencePresent",
        "wearFitEvidencePresent",
        "avatarWardrobeUsedAsGarmentAuthority"
      ],
      "properties": {
        "garmentGeometryEvidencePresent": {
          "type": "boolean"
        },
        "wearFitEvidencePresent": {
          "type": "boolean"
        },
        "avatarWardrobeUsedAsGarmentAuthority": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "EVIDENCE READINESS before generation — deliberately NOT a fit result. PASS, FAIL and UNRESOLVED are outcomes about a depiction that does not exist yet, so they cannot appear here. They remain in the normative Clothing Fit Protocol for evaluating an actual generated depiction. additionalProperties:false is what keeps fitStatus out."
    }
  },
  "required": [
    "schemaVersion",
    "packageRef",
    "generatedAt",
    "isProductTruthRecord",
    "productIdentity",
    "productRole",
    "productGeometrySources",
    "productLocks",
    "creativeFreedoms",
    "riskClassification",
    "productConfidence",
    "knownUncertainties",
    "qaRequirements",
    "humanSubjects",
    "truthConstraints",
    "executionLayer"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "riskClassification"
        ],
        "properties": {
          "riskClassification": {
            "required": [
              "clothingWornOnBody"
