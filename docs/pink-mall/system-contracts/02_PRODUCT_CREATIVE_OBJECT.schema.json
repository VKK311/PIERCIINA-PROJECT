              "BRANDING_MARKINGS",
              "HARDWARE_CLOSURES",
              "CLOTHING_FIT_INTEGRITY",
              "HUMAN_TRUTH_INTEGRITY"
            ]
          },
          "mustEvaluateIfApplicable": {
            "const": true,
            "description": "An OBLIGATION, not an applicability result. Every registered gate must be evaluated if it applies. A pre-generation package cannot decide that a gate does not apply and cannot waive one: applicability is determined after generation, using the contract's qaGates[].mayBeNotApplicable and qaSemantics."
          },
          "numericThreshold": {
            "type": "null",
            "description": "Always null. No numeric threshold is defined by contract 02."
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "gateId"
            ],
            "properties": {
              "gateId": {
                "const": "PRODUCT_IDENTITY"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
