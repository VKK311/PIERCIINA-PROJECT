            "properties": {
              "garmentGeometryEvidencePresent": {
                "const": true
              },
              "avatarWardrobeUsedAsGarmentAuthority": {
                "const": false
              }
            }
          }
        }
      },
      "$comment": "A generation-ready package for body-worn clothing must be HIGH risk, must carry clothing-fit evidence, must actually have garment-geometry evidence, and must not have used avatar wardrobe as garment authority. Missing optional wear/fit evidence is declared in knownUncertainties, never invented. The else branch forbids the evidence object entirely when the depiction is not body-worn clothing, so both directions of the rule are structurally present rather than only the required-when-true half.",
      "else": {
        "not": {
          "required": [
            "clothingFitEvidence"
          ]
        },
        "$comment": "Clothing-fit evidence is meaningful only for a body-worn clothing depiction. Carrying it otherwise asserts a readiness that has no subject, so the checker rejects it and the schema must too — otherwise the validator's parity claim is false."
      }
    }
  ],
