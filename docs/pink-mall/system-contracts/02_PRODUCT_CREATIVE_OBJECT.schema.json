            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "IDENTITY"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "VARIANT"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "SILHOUETTE"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "GEOMETRY"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "CONSTRUCTION"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "PROPORTIONS"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "lockId",
              "engaged"
            ],
            "properties": {
              "lockId": {
                "const": "COLOUR"
              },
              "engaged": {
                "const": true
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
