            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        }
      },
      "additionalProperties": false
    },
    "productConfidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "knownUncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Declared, never invented away. An empty array asserts there are none."
    },
    "qaRequirements": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "gateId",
          "mustEvaluateIfApplicable",
          "numericThreshold"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "enum": [
