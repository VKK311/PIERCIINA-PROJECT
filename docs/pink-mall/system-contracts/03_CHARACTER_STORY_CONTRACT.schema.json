            "required": [
              "contractNumber",
              "existenceOwnedHere"
            ],
            "properties": {
              "contractNumber": {
                "const": "06"
              },
              "existenceOwnedHere": {
                "const": false
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "contractNumber",
              "existenceOwnedHere"
            ],
            "properties": {
              "contractNumber": {
