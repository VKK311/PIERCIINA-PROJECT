    "runtimeExists": {
      "const": false
    },
    "authorityGrants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "noIndependentAuthority": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "string"
      }
    },
    "authorityMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CURRENT_STORY",
        "ACTIVE_CAMPAIGNS",
        "WAITING_FOR_APPROVAL",
        "RECENT_WINNER_SOCIAL_SIGNALS",
