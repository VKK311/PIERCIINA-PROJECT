        "EXPERIMENT_LAB": {
          "const": "WORKSTATION_AND_CAMPAIGN_WORKFLOW"
        },
        "WORLD_STORY_MAP": {
          "const": "STORY_STATE_ENGINE_AND_SUPER_BRAIN_SEMANTIC_CONTEXT"
        },
        "REJECTS_AND_LEARNINGS": {
          "const": "WORKSTATION_AND_SUPER_BRAIN"
        }
      }
    },
    "hybridSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simpleCreativeOverview",
        "expandableTechnicalAuditDetail"
