{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VKK311/PIERCIINA-PROJECT/docs/pink-mall/system-contracts/08_HQ_BLUEPRINT_CONTRACT.schema.json",
  "title": "PINK MALL HQ Blueprint Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
