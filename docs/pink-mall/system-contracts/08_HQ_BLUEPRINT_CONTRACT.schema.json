      "type": "array",
      "minItems": 15,
      "items": {
        "type": "string"
      }
    },
    "hardFailures": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationProvidedByThisContract",
        "createsHQRuntime",
        "createsCampaignRegistry",
        "createsApprovalService",
        "createsBudgetLedger",
        "createsWorkstationRuntime",
        "createsSuperBrainRuntime",
        "createsStoryStateEngine",
        "createsSocialIntelligenceEngine",
        "createsPrivateOpsStore"
