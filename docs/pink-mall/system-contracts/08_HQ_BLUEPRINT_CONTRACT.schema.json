    "workstationRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hqMasterStation",
        "separateStationPerCampaign",
        "checkpoints",
        "initialImageExploration",
        "cyberninjASurfaceOpen"
