          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "OWNER"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "CANONICAL_REPOSITORY"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "PRODUCT_ONBOARDING_SYSTEM"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "AVATAR_SKILL"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "FASHION_CONTEXT_BUILDER"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "CAMPAIGN_REGISTRY"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "STORY_STATE_ENGINE"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "SOCIAL_PLATFORM_API"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "SOCIAL_INTELLIGENCE_ENGINE"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "SUPER_BRAIN"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "CYBERNINJAS_STUDIO"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "WORKSTATION"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "CLAUDE_ORCHESTRATOR"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "MODEL_MEMORY"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "CHAT_HISTORY"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "sourceId": {
                "const": "PRIVATE_OPS_STORE"
              }
            },
            "required": [
              "sourceId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "description": "Every required source id must appear exactly once, for the same reason authorityDomains needs it: uniqueItems compares whole objects, so two records could share a sourceId while differing in note or status, satisfying minItems and uniqueItems while another required source is absent. Authority domains reference these ids, so a gap here is a dangling reference."
    },
    "authorityDomains": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "required": [
          "domainId",
          "implementationStatus",
          "primaryAuthority",
          "secondaryEvidence",
          "nonAuthoritative",
          "conflictAction",
          "note"
        ],
        "properties": {
          "domainId": {
            "type": "string",
            "enum": [
              "SYSTEM_GOVERNANCE",
              "CANONICAL_REPOSITORY_STATE",
              "PRODUCT_IDENTITY",
              "PRODUCT_PRICE",
              "PRODUCT_AVAILABILITY_AND_SIZES",
              "CANONICAL_PRODUCT_MEDIA",
              "HUMAN_IDENTITY",
              "AVATAR_CONSENT_STATUS",
              "CAMPAIGN_OPERATIONAL_STATE",
              "STORY_STATE",
              "SOCIAL_RAW_METRICS",
              "SOCIAL_INTERPRETATION",
              "SEMANTIC_CREATIVE_MEMORY",
              "GENERATED_CAMPAIGN_MEDIA",
              "CAMPAIGN_APPROVAL",
              "PAID_GENERATION_AUTHORITY",
              "COMMERCIAL_PUBLICATION",
              "PRIVATE_STRATEGIC_DATA"
            ]
          },
          "implementationStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PARTIAL",
              "PLANNED",
              "BLOCKED",
              "HISTORICAL"
            ]
          },
          "primaryAuthority": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "OWNER",
                "CANONICAL_REPOSITORY",
                "PRODUCT_ONBOARDING_SYSTEM",
                "AVATAR_SKILL",
                "FASHION_CONTEXT_BUILDER",
                "CAMPAIGN_REGISTRY",
                "STORY_STATE_ENGINE",
                "SOCIAL_PLATFORM_API",
                "SOCIAL_INTELLIGENCE_ENGINE",
                "SUPER_BRAIN",
                "CYBERNINJAS_STUDIO",
                "WORKSTATION",
                "CLAUDE_ORCHESTRATOR",
                "MODEL_MEMORY",
                "CHAT_HISTORY",
                "PRIVATE_OPS_STORE"
              ]
            },
            "uniqueItems": true
          },
          "secondaryEvidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "enum": [
                "OWNER",
                "CANONICAL_REPOSITORY",
                "PRODUCT_ONBOARDING_SYSTEM",
                "AVATAR_SKILL",
                "FASHION_CONTEXT_BUILDER",
                "CAMPAIGN_REGISTRY",
                "STORY_STATE_ENGINE",
                "SOCIAL_PLATFORM_API",
                "SOCIAL_INTELLIGENCE_ENGINE",
                "SUPER_BRAIN",
                "CYBERNINJAS_STUDIO",
                "WORKSTATION",
                "CLAUDE_ORCHESTRATOR",
                "MODEL_MEMORY",
                "CHAT_HISTORY",
                "PRIVATE_OPS_STORE"
              ]
            },
            "uniqueItems": true
          },
          "nonAuthoritative": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "enum": [
                "OWNER",
                "CANONICAL_REPOSITORY",
                "PRODUCT_ONBOARDING_SYSTEM",
                "AVATAR_SKILL",
                "FASHION_CONTEXT_BUILDER",
                "CAMPAIGN_REGISTRY",
                "STORY_STATE_ENGINE",
                "SOCIAL_PLATFORM_API",
                "SOCIAL_INTELLIGENCE_ENGINE",
                "SUPER_BRAIN",
                "CYBERNINJAS_STUDIO",
                "WORKSTATION",
                "CLAUDE_ORCHESTRATOR",
                "MODEL_MEMORY",
                "CHAT_HISTORY",
                "PRIVATE_OPS_STORE"
              ]
            },
            "uniqueItems": true
          },
          "conflictAction": {
            "type": "string",
            "enum": [
              "STOP",
              "CANONICAL_WINS",
              "REJECT_CANDIDATE",
              "CLASSIFY_OVERRIDE",
              "ROUTE_TO_DOMAIN_AUTHORITY",
              "FLAG_STALE"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "SYSTEM_GOVERNANCE"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
