            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "description": "Every required authority domain must appear exactly once. minItems and uniqueItems are insufficient on their own: uniqueItems compares whole objects, so two records could share a domainId while differing in another field, satisfying the array constraints while a required domain is absent. The allOf below carries one contains rule per domain id with minContains/maxContains of 1, which is what actually enforces exactly-once coverage."
    },
    "ownerOverrideTypes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "typeId",
          "scope",
          "mutatesPolicy",
          "rule"
        ],
        "properties": {
          "typeId": {
            "type": "string",
            "enum": [
              "ONE_TIME_EXCEPTION",
              "DURABLE_POLICY_CHANGE"
            ]
          },
          "scope": {
            "type": "string"
          },
          "mutatesPolicy": {
            "type": "boolean"
          },
          "rule": {
            "type": "string"
          },
          "example": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "ownerAuthorityRules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conflictRules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "ruleId",
          "condition",
          "action",
          "mayAutoResolve",
          "detail"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "STOP",
              "CANONICAL_WINS",
              "REJECT_CANDIDATE",
              "CLASSIFY_OVERRIDE",
              "ROUTE_TO_DOMAIN_AUTHORITY",
              "FLAG_STALE"
            ]
