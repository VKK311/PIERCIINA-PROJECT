            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "SOCIAL_INTERPRETATION"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "SEMANTIC_CREATIVE_MEMORY"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "GENERATED_CAMPAIGN_MEDIA"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "CAMPAIGN_APPROVAL"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "PAID_GENERATION_AUTHORITY"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "COMMERCIAL_PUBLICATION"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "PRIVATE_STRATEGIC_DATA"
              }
            },
            "required": [
