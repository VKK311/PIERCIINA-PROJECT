{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VKK311/PIERCIINA-PROJECT/docs/pink-mall/system-contracts/00_SYSTEM_AUTHORITY_CONTRACT.schema.json",
  "title": "PINK MALL System Authority Contract",
  "description": "Schema for the constitutional authority contract. Deliberately strict: every authority domain is required by name so a domain cannot be dropped silently, vocabularies are closed enums, and additional top-level properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractId": {
      "const": "PINK_MALL_SYSTEM_AUTHORITY_CONTRACT"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "CANONICAL",
        "SUPERSEDED"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "appliesTo": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "canonicalityRule": {
      "type": "object",
      "required": [
        "ruleId",
        "statement",
        "conditions",
        "fileExistenceImpliesCanonicality",
        "candidateBranchIsReviewMaterial",
        "statusFieldSemantics",
        "statusRule",
        "statusSemantics"
      ],
      "properties": {
        "ruleId": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "fileExistenceImpliesCanonicality": {
          "const": false
        },
        "candidateBranchIsReviewMaterial": {
          "const": true
        },
        "statusFieldSemantics": {
          "type": "object",
          "required": [
            "CANDIDATE",
            "CANONICAL",
            "SUPERSEDED"
          ],
          "properties": {
            "CANDIDATE": {
              "type": "string",
              "minLength": 1
            },
            "CANONICAL": {
              "type": "string",
              "minLength": 1
            },
            "SUPERSEDED": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "promotionNote": {
          "type": "string"
        },
        "statusRule": {
          "type": "string",
          "minLength": 1
        },
        "statusSemantics": {
          "type": "object",
          "required": [
            "canonicalityLabels",
            "tombstoneLabels",
            "candidateAloneDeniesCanonicality",
            "canonicalAloneGrantsCanonicality",
            "supersededDisqualifiesReliance",
            "exactByteCandidatePromotionPermitted",
            "rule",
            "promotionRule"
          ],
          "properties": {
            "canonicalityLabels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "CANDIDATE",
                  "CANONICAL"
                ]
              }
            },
            "tombstoneLabels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "SUPERSEDED"
                ]
              }
            },
            "candidateAloneDeniesCanonicality": {
              "const": false
            },
            "canonicalAloneGrantsCanonicality": {
              "const": false
            },
            "supersededDisqualifiesReliance": {
              "const": true
            },
            "exactByteCandidatePromotionPermitted": {
              "const": true
            },
            "rule": {
              "type": "string",
              "minLength": 1
            },
            "promotionRule": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "implementationStates": {
      "type": "object",
      "required": [
        "ACTIVE",
        "PARTIAL",
        "PLANNED",
        "BLOCKED",
        "HISTORICAL"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "truthClasses": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "classId",
          "definition",
          "mutableBy"
        ],
        "properties": {
          "classId": {
            "type": "string",
            "enum": [
              "FACT",
              "DERIVED_FACT",
              "INTERPRETATION",
              "PROPOSAL",
              "GENERATED_OUTPUT",
              "APPROVAL"
            ]
          },
          "definition": {
            "type": "string"
          },
          "mutableBy": {
            "type": "string"
          },
          "example": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "truthClassRules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mediaClasses": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "classId",
          "definition",
          "generativeAlterationAllowed",
          "authority",
          "rule"
        ],
        "properties": {
          "classId": {
            "type": "string",
            "enum": [
              "CANONICAL_COMMERCE_MEDIA",
              "CAMPAIGN_MEDIA",
              "DERIVATIVE_MEDIA"
            ]
          },
          "definition": {
            "type": "string"
          },
          "generativeAlterationAllowed": {
            "type": "boolean"
          },
          "authority": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "mediaClassRules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sourceTypes": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "role",
          "implementationStatus",
          "mayAssertFacts"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "enum": [
              "OWNER",
              "CANONICAL_REPOSITORY",
              "PRODUCT_ONBOARDING_SYSTEM",
              "AVATAR_SKILL",
              "FASHION_CONTEXT_BUILDER",
              "CAMPAIGN_REGISTRY",
              "STORY_STATE_ENGINE",
              "SOCIAL_PLATFORM_API",
              "SOCIAL_INTELLIGENCE_ENGINE",
              "SUPER_BRAIN",
              "CYBERNINJAS_STUDIO",
              "WORKSTATION",
              "CLAUDE_ORCHESTRATOR",
              "MODEL_MEMORY",
              "CHAT_HISTORY",
              "PRIVATE_OPS_STORE"
