{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VKK311/PIERCIINA-PROJECT/docs/pink-mall/system-contracts/01_CAMPAIGN_CONTEXT_OBJECT.schema.json",
  "title": "PINK MALL Campaign Context package",
  "description": "Shape of the runtime package a future Campaign Context Builder will emit. No builder exists. Instances are snapshots and MUST NOT be committed to this public repository.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contextRef": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference, unique within this package only. Persistent campaign ids belong to a future operational system and are NOT defined here."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "inputSummary": {
      "type": "array",
      "minItems": 6,
      "description": "Provenance and availability for every input domain. Absence must be declared, never implied. Rules 1-6 require each domain exactly once; rules 7-12 bind each domain to its contract-fixed requirement, and bind the three REQUIRED_TRUTH_INPUT domains to availability AVAILABLE. Because a domain appears exactly once, binding one matching record binds that record: a package cannot relabel CURRENT_PRODUCTS as optional, nor emit a required truth input as UNAVAILABLE.",
      "items": {
        "type": "object",
        "required": [
          "domainId",
          "availability",
          "inputClass",
          "requirement"
        ],
        "properties": {
          "domainId": {
            "type": "string",
            "enum": [
              "WORLD_STORY_STATE",
              "CULTURAL_SOCIAL_SIGNALS",
              "BRAND_DNA_HERITAGE",
              "CHARACTER_CONTEXT",
              "CURRENT_PRODUCTS",
              "TARGET_FORMAT"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE",
              "NOT_APPLICABLE"
            ]
          },
          "inputClass": {
            "type": "string",
            "enum": [
              "CANONICAL_FACT",
              "DERIVED_FACT",
              "LOCKED_OWNER_DECISION",
              "OPERATIONAL_STATE",
              "SOCIAL_OR_CULTURAL_SIGNAL",
              "SEMANTIC_INTERPRETATION",
              "PRIVATE_OPS_REFERENCE",
              "UNAVAILABLE_INPUT"
            ]
          },
          "requirement": {
            "type": "string",
            "enum": [
              "REQUIRED_TRUTH_INPUT",
              "OPTIONAL_CONTEXT_INPUT"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "availability"
              ],
              "properties": {
                "availability": {
                  "const": "UNAVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "inputClass": {
                  "const": "UNAVAILABLE_INPUT"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "inputClass"
              ],
              "properties": {
                "inputClass": {
                  "const": "UNAVAILABLE_INPUT"
                }
              }
            },
            "then": {
              "properties": {
                "availability": {
                  "const": "UNAVAILABLE"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "WORLD_STORY_STATE"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "CULTURAL_SOCIAL_SIGNALS"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "BRAND_DNA_HERITAGE"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "CHARACTER_CONTEXT"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "CURRENT_PRODUCTS"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "domainId": {
                "const": "TARGET_FORMAT"
              }
            },
            "required": [
              "domainId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "domainId",
              "requirement"
            ],
            "properties": {
              "domainId": {
                "const": "WORLD_STORY_STATE"
              },
              "requirement": {
                "const": "OPTIONAL_CONTEXT_INPUT"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "domainId",
              "requirement"
            ],
            "properties": {
              "domainId": {
                "const": "CULTURAL_SOCIAL_SIGNALS"
              },
              "requirement": {
                "const": "OPTIONAL_CONTEXT_INPUT"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "domainId",
              "requirement",
              "availability"
            ],
            "properties": {
              "domainId": {
                "const": "BRAND_DNA_HERITAGE"
              },
              "requirement": {
                "const": "REQUIRED_TRUTH_INPUT"
              },
              "availability": {
                "const": "AVAILABLE"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "domainId",
              "requirement"
            ],
            "properties": {
              "domainId": {
                "const": "CHARACTER_CONTEXT"
              },
              "requirement": {
                "const": "OPTIONAL_CONTEXT_INPUT"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "domainId",
              "requirement",
              "availability"
            ],
            "properties": {
              "domainId": {
                "const": "CURRENT_PRODUCTS"
              },
              "requirement": {
                "const": "REQUIRED_TRUTH_INPUT"
              },
              "availability": {
                "const": "AVAILABLE"
              }
            }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "domainId",
              "requirement",
              "availability"
            ],
            "properties": {
              "domainId": {
                "const": "TARGET_FORMAT"
              },
              "requirement": {
                "const": "REQUIRED_TRUTH_INPUT"
              },
              "availability": {
                "const": "AVAILABLE"
              }
            }
          },
          "minContains": 1
        }
      ]
    },
    "brandConstraints": {
      "type": "object",
      "required": [
        "heritageSource",
        "mustRemainSpecific"
      ],
      "properties": {
        "heritageSource": {
          "type": "string",
          "minLength": 1
        },
        "mustRemainSpecific": {
          "const": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "truthConstraints": {
      "type": "object",
      "required": [
        "productTruthMayBeTransformed",
        "humanIdentityMayBeTransformed",
        "worldPhysicsMayBreak"
      ],
      "properties": {
        "productTruthMayBeTransformed": {
          "const": false
        },
        "humanIdentityMayBeTransformed": {
          "const": false
        },
        "worldPhysicsMayBreak": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "targetFormat": {
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ideas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "description": "INITIAL mode emits exactly three competing proposals. Fewer or more is a STOP condition.",
      "items": {
        "type": "object",
        "required": [
          "ideaRef",
          "title",
          "worldPremise",
          "purpose",
          "productRole",
          "characterRole",
          "targetFormatIntent",
          "creativeMechanisms",
          "truthRisks",
          "state"
        ],
        "properties": {
          "ideaRef": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "worldPremise": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "productRole": {
            "type": "string",
            "enum": [
              "NONE",
              "DETAIL",
              "SUPPORTING",
              "HERO"
            ]
          },
          "characterRole": {
            "type": "string",
            "enum": [
              "INA",
              "SIS",
              "DUO",
              "NONE"
            ]
          },
          "targetFormatIntent": {
            "type": "string",
            "minLength": 1
          },
          "creativeMechanisms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "truthRisks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "privateDetailRefs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "References only. Private content MUST NOT appear in this package."
          },
          "state": {
            "type": "string",
            "enum": [
              "PROPOSAL",
              "OWNER_SELECTED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "contextRef",
    "inputSummary",
    "brandConstraints",
    "truthConstraints",
    "targetFormat",
    "ideas",
    "generatedAt"
  ],
  "x-notPermittedStates": [
    "PUBLISHED",
    "EXECUTING",
    "APPROVED_SPEND",
    "APPROVED",
    "SCHEDULED"
  ],
  "x-note": "Idea state is limited to PROPOSAL and OWNER_SELECTED. Execution, spend and publication states are outside contract 01's authority and belong to contract 06.",
  "x-domainRequirement": {
    "WORLD_STORY_STATE": "OPTIONAL_CONTEXT_INPUT",
    "CULTURAL_SOCIAL_SIGNALS": "OPTIONAL_CONTEXT_INPUT",
    "BRAND_DNA_HERITAGE": "REQUIRED_TRUTH_INPUT",
    "CHARACTER_CONTEXT": "OPTIONAL_CONTEXT_INPUT",
    "CURRENT_PRODUCTS": "REQUIRED_TRUTH_INPUT",
    "TARGET_FORMAT": "REQUIRED_TRUTH_INPUT"
  },
  "x-unavailableSemantics": "availability UNAVAILABLE and inputClass UNAVAILABLE_INPUT are equivalent and each implies the other. UNAVAILABLE_INPUT is defined as 'the input could not be obtained', which is exactly what UNAVAILABLE records, so an unavailable input does NOT retain an underlying provenance class. NOT_APPLICABLE is a different state: the input was not sought rather than not obtained, so it keeps the domain's provenance class and MUST NOT be UNAVAILABLE_INPUT."
}
